# SAVIOR paper figure style: mimics the original JSEN paper plots (see docs/FIGURE_STYLE.md)
figure.facecolor: white
axes.facecolor: white
axes.edgecolor: black
axes.linewidth: 0.8
axes.grid: False
axes.spines.top: True
axes.spines.right: True
axes.titlesize: 10
axes.labelsize: 9
axes.prop_cycle: cycler('color', ['blue', 'red', 'black', 'green', 'magenta', 'orange'])
font.family: sans-serif
font.size: 9
xtick.labelsize: 8
ytick.labelsize: 8
xtick.direction: out
ytick.direction: out
lines.linewidth: 1.2
legend.frameon: True
legend.fancybox: True
legend.framealpha: 0.9
legend.edgecolor: 0.8
legend.fontsize: 8
boxplot.notch: True
boxplot.showfliers: False
savefig.dpi: 300
savefig.bbox: tight
