diff -ruN vf_orig/vins_estimator/src/featureTracker/savior_mask.cpp vf_new/vins_estimator/src/featureTracker/savior_mask.cpp
--- a/vins_estimator/src/featureTracker/savior_mask.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/vins_estimator/src/featureTracker/savior_mask.cpp	2026-10-24 15:34:14.408625673 +0000
@@ -0,0 +1,92 @@
+/*******************************************************
+ * SAVIOR dynamic-mask support for VINS-Fusion (SAVIOR sota patch P9). GPL-3.0.
+ *******************************************************/
+#include "savior_mask.h"
+
+#include <chrono>
+#include <sys/stat.h>
+#include <thread>
+
+SaviorParams SAVIOR;
+int64_t SAVIOR_CUR_STAMP_NS = -1;
+SaviorMaskSource SAVIOR_MASKS;
+
+static bool exists(const std::string &p)
+{
+    struct stat st;
+    return stat(p.c_str(), &st) == 0;
+}
+
+void readSaviorParameters(cv::FileStorage &fs)
+{
+    if (!fs["savior_mask_dir"].empty()) fs["savior_mask_dir"] >> SAVIOR.mask_dir;
+    if (!fs["savior_mask_mode"].empty()) fs["savior_mask_mode"] >> SAVIOR.mode;
+    if (!fs["savior_mask_threshold"].empty()) SAVIOR.threshold = (int)fs["savior_mask_threshold"];
+    if (!fs["savior_mask_relaxed_threshold"].empty()) SAVIOR.relaxed_threshold = (int)fs["savior_mask_relaxed_threshold"];
+    if (!fs["savior_mask_min_features"].empty()) SAVIOR.min_features = (int)fs["savior_mask_min_features"];
+    if (!fs["savior_mask_latency_ms"].empty()) SAVIOR.latency_ms = (double)fs["savior_mask_latency_ms"];
+    if (!fs["savior_mask_wait_ms"].empty()) SAVIOR.wait_ms = (int)fs["savior_mask_wait_ms"];
+    if (!fs["savior_mask_stats"].empty()) fs["savior_mask_stats"] >> SAVIOR.stats_path;
+    if (!fs["savior_deterministic"].empty()) SAVIOR.deterministic = (int)fs["savior_deterministic"];
+    if (!fs["savior_ignore_solver_time"].empty()) SAVIOR.ignore_solver_time = (int)fs["savior_ignore_solver_time"];
+    if (SAVIOR.enabled() && SAVIOR.mode != "gate" && SAVIOR.mode != "deferred")
+    {
+        printf("[SAVIOR] unknown savior_mask_mode '%s'\n", SAVIOR.mode.c_str());
+        exit(2);
+    }
+    printf("[SAVIOR] mask_dir='%s' mode=%s threshold=%d relaxed=%d min_features=%d latency_ms=%.1f wait_ms=%d "
+           "deterministic=%d ignore_solver_time=%d\n",
+           SAVIOR.mask_dir.c_str(), SAVIOR.mode.c_str(), SAVIOR.threshold, SAVIOR.relaxed_threshold, SAVIOR.min_features,
+           SAVIOR.latency_ms, SAVIOR.wait_ms, SAVIOR.deterministic, SAVIOR.ignore_solver_time);
+}
+
+cv::Mat SaviorMaskSource::load(int64_t stamp_ns, int cam, int rows, int cols)
+{
+    std::string p = SAVIOR.mask_dir + (cam == 0 ? "/left/" : "/right/") + std::to_string(stamp_ns) + ".png";
+    if (!exists(p) && SAVIOR.wait_ms > 0)
+    {
+        auto t0 = std::chrono::steady_clock::now();
+        while (!exists(p) && std::chrono::steady_clock::now() - t0 < std::chrono::milliseconds(SAVIOR.wait_ms))
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    if (!exists(p))
+        return cv::Mat();
+    cv::Mat m = cv::imread(p, cv::IMREAD_UNCHANGED);
+    if (m.empty() || m.type() != CV_8UC1 || m.rows != rows || m.cols != cols)
+    {
+        n_bad_size++;
+        return cv::Mat();
+    }
+    return m;
+}
+
+void SaviorMaskSource::frameStats(int64_t stamp_ns, const char *what, const std::vector<long> &vals)
+{
+    if (SAVIOR.stats_path.empty())
+        return;
+    if (!stats_init_)
+    {
+        stats_init_ = true;
+        stats_ = fopen(SAVIOR.stats_path.c_str(), "w");
+        if (stats_)
+            fprintf(stats_, "stamp_ns,kind,v0,v1,v2,v3,v4,v5,v6,v7\n");
+    }
+    if (!stats_)
+        return;
+    fprintf(stats_, "%lld,%s", (long long)stamp_ns, what);
+    for (long v : vals)
+        fprintf(stats_, ",%ld", v);
+    fprintf(stats_, "\n");
+    fflush(stats_);
+}
+
+void SaviorMaskSource::summary(bool final_)
+{
+    printf("[SAVIOR]%s frames=%ld found=%ld missing=%ld bad_size=%ld drop_tracked_l=%ld drop_tracked_r=%ld relaxed_l=%ld "
+           "relaxed_r=%ld in_core_l=%ld in_core_r=%ld deferred_masks=%ld deferred_missing=%ld flagged=%ld "
+           "flagged_tracked=%ld solves=%ld solver_time_hits=%ld\n",
+           final_ ? " FINAL" : "", n_frames, n_found, n_missing, n_bad_size, n_drop_tracked_l, n_drop_tracked_r, n_relaxed_l,
+           n_relaxed_r, n_in_core_l, n_in_core_r, n_deferred_masks, n_deferred_missing, n_flagged, n_flagged_tracked,
+           n_solves, n_solver_time_hits);
+    fflush(stdout);
+}
