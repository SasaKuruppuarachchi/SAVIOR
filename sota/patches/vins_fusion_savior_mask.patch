+++ b/vins_estimator/src/featureTracker/savior_mask.h	2026-10-24 15:33:59.365940655 +0000
@@ -0,0 +1,81 @@
+/*******************************************************
+ * SAVIOR dynamic-mask support for VINS-Fusion (SAVIOR sota patch P9).
+ * Licensed under the GNU General Public License v3.0 (as VINS-Fusion).
+ *
+ * Layered per-frame masks (mono8, raw image size): 0 keep, 192 extension band (relaxable), 255 dynamic core.
+ * Masks are PNG files <savior_mask_dir>/{left,right}/<left image header stamp in ns>.png (exact stamp sync).
+ * All keys are optional; without `savior_mask_dir` and `savior_deterministic` VINS-Fusion is unchanged.
+ *
+ *   savior_mask_dir: "/abs/dir"          # enables masking
+ *   savior_mask_mode: "gate"             # gate     = current-frame gating (as the OpenVINS fork, policy "wait"):
+ *                                        #            tracked features whose current pixel is masked are dropped
+ *                                        #            (left and right), no new detection on masked pixels
+ *                                        # deferred = SAVIOR-edge latency emulation: no current-frame gating; the
+ *                                        #            mask of frame k "arrives" at the first frame j with
+ *                                        #            t_j >= t_k + latency, and every feature observed inside it at
+ *                                        #            frame k is invalidated: dropped from the tracker and removed
+ *                                        #            from the estimator's sliding window (FeatureManager)
+ *   savior_mask_threshold: 128           # pixel >= threshold is masked (128: core + band)
+ *   savior_mask_relaxed_threshold: 224   # used for a camera whose kept tracked features < min_features (drops band)
+ *   savior_mask_min_features: 30         # <= 0: no relaxation
+ *   savior_mask_latency_ms: 250          # deferred mode only
+ *   savior_mask_wait_ms: 0               # wait (wall) for a missing mask file; 0 = offline (all files exist)
+ *   savior_mask_stats: "/abs/file.csv"   # per-frame statistics (optional)
+ *   savior_deterministic: 1              # synchronous estimator (no processing thread, same frame selection as
+ *                                        # multiple_thread: every 2nd frame): removes the tracker/estimator race
+ *   savior_ignore_solver_time: 0         # 1: max_solver_time not applied (iteration cap only; wall-clock free)
+ *******************************************************/
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+#include <opencv2/opencv.hpp>
+
+struct SaviorParams
+{
+    std::string mask_dir;
+    std::string mode = "gate";
+    int threshold = 128;
+    int relaxed_threshold = 224;
+    int min_features = 30;
+    double latency_ms = 250.0;
+    int wait_ms = 0;
+    std::string stats_path;
+    int deterministic = 0;
+    int ignore_solver_time = 0;
+    bool enabled() const { return !mask_dir.empty(); }
+    bool deferred() const { return enabled() && mode == "deferred"; }
+    bool gate() const { return enabled() && mode == "gate"; }
+};
+
+extern SaviorParams SAVIOR;
+// exact header stamp (ns) of the left image currently handed to the tracker (set by the ROS node)
+extern int64_t SAVIOR_CUR_STAMP_NS;
+
+void readSaviorParameters(cv::FileStorage &fs);
+
+// mask file access + counters + per-frame statistics
+class SaviorMaskSource
+{
+public:
+    // cam 0 = left, 1 = right; returns an empty Mat if the file is missing (or has the wrong size)
+    cv::Mat load(int64_t stamp_ns, int cam, int rows, int cols);
+    void frameStats(int64_t stamp_ns, const char *what, const std::vector<long> &vals);
+    void summary(bool final_);
+
+    long n_frames = 0, n_found = 0, n_missing = 0, n_bad_size = 0;
+    long n_drop_tracked_l = 0, n_drop_tracked_r = 0, n_relaxed_l = 0, n_relaxed_r = 0;
+    long n_in_core_l = 0, n_in_core_r = 0;
+    long n_deferred_masks = 0, n_deferred_missing = 0, n_flagged = 0, n_flagged_tracked = 0;
+    long n_solver_time_hits = 0, n_solves = 0;
+
+private:
+    FILE *stats_ = nullptr;
+    bool stats_init_ = false;
+};
+
+extern SaviorMaskSource SAVIOR_MASKS;
