+// SAVIOR P9 (savior_deterministic): process the queued frames synchronously, each one as soon as the IMU covers it
+// (blocking the image thread; IMU messages keep arriving through the ROS spinner). Same frames as the upstream
+// processing thread (multiple_thread: every 2nd frame), but the tracker prediction set by processImage() is always in
+// place for the next frame, so the result no longer depends on thread timing.
+void Estimator::saviorProcessSync(double t)
+{
+    auto t0 = std::chrono::steady_clock::now();
+    while (1)
+    {
+        mBuf.lock();
+        bool ok = !USE_IMU || IMUAvailable(t + td);
+        mBuf.unlock();
+        if (ok)
+            break;
+        if (std::chrono::steady_clock::now() - t0 > std::chrono::seconds(10))
+        {
+            printf("[SAVIOR] no IMU up to t=%.9f after 10 s: frame kept queued\n", t);
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(500));
+    }
+    while (1)
+    {
+        mBuf.lock();
+        bool ok = !featureBuf.empty() && (!USE_IMU || IMUAvailable(featureBuf.front().first + td));
+        mBuf.unlock();
+        if (!ok)
+            break;
+        processMeasurements();
+    }
+}
