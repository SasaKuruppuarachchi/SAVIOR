+// SAVIOR P9: mask value at a (sub-)pixel position (nearest pixel, clamped)
+static inline int saviorAt(const cv::Mat &m, const cv::Point2f &p)
+{
+    int x = std::min(std::max(cvRound(p.x), 0), m.cols - 1);
+    int y = std::min(std::max(cvRound(p.y), 0), m.rows - 1);
+    return m.at<uchar>(y, x);
+}
+
+// SAVIOR P9 (deferred / SAVIOR-edge latency emulation, = OpenVINS fork dynamic_mask_deferred with stale gating off):
+// the mask of frame k arrives at the first frame j with t_j >= t_k + latency; every feature observed inside it at
+// frame k (left or right, pixel >= threshold) is invalidated: removed from the current tracks (never tracked again)
+// and reported to the estimator (removed from the sliding window).
+void FeatureTracker::saviorDeferred(int64_t st, bool stereo)
+{
+    const int64_t cut = st - (int64_t)llround(SAVIOR.latency_ms * 1e6);
+    std::set<int> F;
+    while (!savior_hist.empty() && savior_hist.front().stamp <= cut)
+    {
+        const SaviorObs &h = savior_hist.front();
+        if (h.stamp > savior_cut)
+        {
+            cv::Mat ml = SAVIOR_MASKS.load(h.stamp, 0, row, col);
+            cv::Mat mr = stereo ? SAVIOR_MASKS.load(h.stamp, 1, row, col) : cv::Mat();
+            if (ml.empty())
+                SAVIOR_MASKS.n_deferred_missing++;
+            else
+                SAVIOR_MASKS.n_deferred_masks++;
+            if (!ml.empty())
+                for (size_t i = 0; i < h.ids.size(); i++)
+                    if (saviorAt(ml, h.pts[i]) >= SAVIOR.threshold)
+                        F.insert(h.ids[i]);
+            if (!mr.empty())
+                for (size_t i = 0; i < h.ids_r.size(); i++)
+                    if (saviorAt(mr, h.pts_r[i]) >= SAVIOR.threshold)
+                        F.insert(h.ids_r[i]);
+        }
+        savior_hist.pop_front();
+    }
+    savior_cut = std::max(savior_cut, cut);
+    long n_tracked = 0;
+    if (!F.empty())
+    {
+        vector<uchar> s(ids.size());
+        for (size_t i = 0; i < ids.size(); i++)
+        {
+            s[i] = F.count(ids[i]) ? 0 : 1;
+            n_tracked += 1 - s[i];
+        }
+        reduceVector(cur_pts, s);
+        reduceVector(ids, s);
+        reduceVector(track_cnt, s);
+        reduceVector(cur_un_pts, s);
+        reduceVector(pts_velocity, s);
+        vector<uchar> sr(ids_right.size());
+        for (size_t i = 0; i < ids_right.size(); i++)
+            sr[i] = F.count(ids_right[i]) ? 0 : 1;
+        reduceVector(cur_right_pts, sr);
+        reduceVector(ids_right, sr);
+        reduceVector(cur_un_right_pts, sr);
+        reduceVector(right_pts_velocity, sr);
+        for (int id : F)
+            savior_flagged.insert(id);
+    }
+    SAVIOR_MASKS.n_flagged += (long)F.size();
+    SAVIOR_MASKS.n_flagged_tracked += n_tracked;
+    SAVIOR_MASKS.frameStats(st, "deferred", {(long)F.size(), n_tracked});
+    SaviorObs o;
+    o.stamp = st;
+    o.ids = ids;
+    o.pts = cur_pts;
+    if (stereo)
+    {
+        o.ids_r = ids_right;
+        o.pts_r = cur_right_pts;
+    }
+    savior_hist.push_back(o);
 }
 
